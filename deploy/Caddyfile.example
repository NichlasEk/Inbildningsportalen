# Add these handlers inside the relevant apothictech.se site block.

handle /api/pharmatest* {
	reverse_proxy 127.0.0.1:8798
}
handle /api/forfattning* {
	reverse_proxy 127.0.0.1:8798
}
handle /api/galenik* {
	reverse_proxy 127.0.0.1:8798
}
handle /api/farmakognosi* {
	reverse_proxy 127.0.0.1:8798
}
handle /api/interaktioner* {
	reverse_proxy 127.0.0.1:8798
}
handle /api/doslab* {
	reverse_proxy 127.0.0.1:8798
}
handle /api/pungdjur* {
	reverse_proxy 127.0.0.1:8798
}

@inbildningsportalenExact path /inbildningsportalen
redir @inbildningsportalenExact /inbildningsportalen/ 308
handle_path /inbildningsportalen/* {
	root * /srv/apothictech-site/inbildningsportalen
	file_server
}

@pharmatestExact path /pharmatest
redir @pharmatestExact /pharmatest/ 308
handle_path /pharmatest/* {
	root * /srv/apothictech-site/pharmatest
	file_server
}

